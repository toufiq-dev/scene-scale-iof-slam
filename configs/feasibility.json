{
  "experiment": "synthetic-feasibility-fixed",
  "description": "Corrected feasibility gate with the G3 confound fixed and round-2 review fixes applied: estimated (corrupted) motion by default, oracle vs runtime-available baselines, GRU + classical covariance-propagation baselines, per-sequence (within-sequence) failure thresholds as the primary early-warning metric, full input-combination ablation matrix, and a generator stress matrix (degraded reliability, jump failures, realistic depth corruption).",
  "seeds": [0, 1, 2],
  "data": {
    "n_train": 60,
    "n_val": 15,
    "n_test": 15,
    "seq_len": 80,
    "seed_base": 1000
  },
  "generator": {
    "error_model": "decoupled",
    "motion_source": "estimated",
    "reliability_mode": "clean",
    "jump_prob": 0.0,
    "depth_corruption": "gaussian",
    "depth_choices": [0.5, 0.8, 1.2, 2.0, 4.0, 8.0, 15.0, 30.0],
    "rot_innov_weight": 0.3,
    "stress_variants": [
      "true motion (pre-fix input)",
      "reliability: delayed",
      "reliability: noisy",
      "reliability: miscalibrated",
      "reliability: masked",
      "reliability: intermittent",
      "jump failures",
      "realistic depth corruption"
    ]
  },
  "windows": {
    "k": 5,
    "h": 5,
    "num_samples_iof": 200
  },
  "model": {
    "kind": "mlp",
    "hidden": 128,
    "epochs": 60,
    "patience": 8,
    "lr": 0.001,
    "batch": 256,
    "temporal_baseline": {
      "kind": "gru",
      "hidden": 64,
      "epochs": 150,
      "patience": 12,
      "lr": 0.003
    }
  },
  "baselines": [
    "constant",
    "persistence (oracle)",
    "ridge (same features)",
    "classical cov-prop (blind)",
    "gru (temporal, same features)",
    "analytic 2-stage (phys-explicit)",
    "mlp full h=0 (current)"
  ],
  "ablations": [
    "motion-only",
    "depth-only",
    "reliability-only",
    "motion+depth",
    "motion+reliability",
    "depth+reliability",
    "full"
  ],
  "failure_definitions": [
    "global_tau",
    "per_seq_tau (within-sequence, PRIMARY)",
    "robust_zscore",
    "depth_normalized"
  ],
  "failure_threshold_percentile": 75,
  "metrics": ["rmse", "nrmse", "med_spearman", "auroc", "med_auroc", "wauroc", "med_wauroc", "ap"]
}
